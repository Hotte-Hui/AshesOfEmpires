extends Node
## Audio — ambience/music crossfades, stingers, SFX voice pool, UI sounds, bus volumes.
## Contract: documentation/TECHNICAL_ARCHITECTURE.md §7.  Assets: assets/audio/{amb,music,sfx}/*.wav
## (44.1 kHz / 16-bit PCM, generated by tools/audiogen/build_all.py; loops carry a RIFF 'smpl' chunk
## that Godot's importer turns into LOOP_FORWARD; Audio also enforces looping at runtime).
##
## Public API (stable):
##   play_ambience(id, fade := 1.5)        "" fades the ambience out; same id = no restart
##   play_music(id, fade := 2.0)           "" == stop_music(fade); same id = no restart
##   stop_music(fade := 2.0)
##   sfx(id, volume_db := 0.0, pitch_var := 0.05)   "step_gravel" picks step_gravel_1..N at random
##   ui(id)                                "move" -> ui_move, "type_tick" -> type_tick_1..3, any sfx id
## Extras: stop_ambience(fade), sting(id, duck_db, fade), sfx_loop(id, key, volume_db, fade),
##   stop_sfx_loop(key, fade), has_sound(id), current_music(), current_ambience(),
##   set_bus_volume_linear(bus, value), preload_sound(id).
## Every call is a graceful no-op (one warning per missing file) when a sound does not exist.
## Crossfades are equal-power; any number of overlapping changes is safe (each track owns a
## player while it fades out).  Runs while the game is paused (PROCESS_MODE_ALWAYS).

const DIR_AMB := "res://assets/audio/amb/"
const DIR_MUSIC := "res://assets/audio/music/"
const DIR_SFX := "res://assets/audio/sfx/"

const BUSES := ["Music", "Ambience", "SFX", "UI"]
## Settings keys -> bus names (Settings.apply() capitalises "sfx"/"ui" to "Sfx"/"Ui", which do not
## match the bus names, so Audio applies these volumes itself).
const VOLUME_KEYS := {
	"master_volume": "Master", "music_volume": "Music", "ambience_volume": "Ambience",
	"sfx_volume": "SFX", "ui_volume": "UI",
}
## Music that loops (every other file under music/ is a one-shot cue / stinger).
const LOOPING_MUSIC := ["mus_karsk", "mus_berlin", "mus_menu"]
const SFX_VOICES := 16
const UI_VOICES := 6
const MIN_DB := -80.0

var _amb := _Channel.new("Ambience", "Amb")
var _mus := _Channel.new("Music", "Mus")
var _sfx_players: Array[AudioStreamPlayer] = []
var _ui_players: Array[AudioStreamPlayer] = []
var _sfx_next := 0
var _ui_next := 0
var _loops: Dictionary = {}            # key -> _Fader
var _sting: AudioStreamPlayer
var _duck := 1.0
var _duck_target := 1.0
var _duck_rate := 0.0
var _cache: Dictionary = {}             # path -> AudioStream (sfx/ui only; music/ambience are freed)
var _variants: Dictionary = {}          # id -> PackedStringArray of resolved file ids
var _last_variant: Dictionary = {}      # id -> last picked file id (no immediate repeats)
var _warned: Dictionary = {}
var _rng := RandomNumberGenerator.new()


class _Fader:
	## One player with an equal-power gain ramp (power interpolated linearly in time).
	var player: AudioStreamPlayer
	var gain := 0.0
	var from := 0.0
	var to := 0.0
	var t := 0.0
	var dur := 0.0
	var stop_at_end := false

	func start(target: float, seconds: float, stop_after: bool) -> void:
		from = gain
		to = target
		t = 0.0
		dur = maxf(seconds, 0.0)
		stop_at_end = stop_after
		if dur == 0.0:
			gain = to

	func step(delta: float) -> bool:
		## Returns true while a ramp is running.
		if dur <= 0.0 or t >= dur:
			return false
		t = minf(t + delta, dur)
		gain = sqrt(lerpf(from * from, to * to, t / dur))
		return t < dur


class _Channel:
	var bus := ""
	var prefix := ""
	var active: _Fader = null
	var fading: Array = []                # faders ramping out (freed when silent)
	var current := ""
	var serial := 0

	func _init(b: String, p: String) -> void:
		bus = b
		prefix = p


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_setup()
	_hook_settings()


## Idempotent; also runs lazily if the API is used before _ready (e.g. from another autoload).
func _setup() -> void:
	if _sting != null:
		return
	_rng.randomize()
	_ensure_buses()
	for i in SFX_VOICES:
		_sfx_players.append(_make_player("Sfx%d" % i, "SFX"))
	for i in UI_VOICES:
		_ui_players.append(_make_player("Ui%d" % i, "UI"))
	_sting = _make_player("Sting", "Music")
	_sting.finished.connect(_on_sting_finished)


# ------------------------------------------------------------------------------------- public API
func play_ambience(id: String, fade: float = 1.5) -> void:
	_play_channel(_amb, id, DIR_AMB, fade, true)


func stop_ambience(fade: float = 1.5) -> void:
	_play_channel(_amb, "", DIR_AMB, fade, true)


func play_music(id: String, fade: float = 2.0) -> void:
	_play_channel(_mus, id, DIR_MUSIC, fade, id in LOOPING_MUSIC)


func stop_music(fade: float = 2.0) -> void:
	_play_channel(_mus, "", DIR_MUSIC, fade, false)


func current_music() -> String:
	return _mus.current


func current_ambience() -> String:
	return _amb.current


func sfx(id: String, volume_db: float = 0.0, pitch_var: float = 0.05) -> void:
	_setup()
	var stream := _resolve_oneshot(id)
	if stream == null:
		return
	var p := _next_voice(_sfx_players, true)
	p.stream = stream
	p.volume_db = volume_db
	p.pitch_scale = clampf(1.0 + _rng.randf_range(-pitch_var, pitch_var), 0.5, 2.0) if pitch_var > 0.0 else 1.0
	p.play()


func ui(id: String) -> void:
	_setup()
	var stream: AudioStream = null
	if not id.begins_with("ui_"):
		stream = _resolve_oneshot("ui_" + id, false)
	if stream == null:
		stream = _resolve_oneshot(id)
	if stream == null:
		return
	var p := _next_voice(_ui_players, false)
	p.stream = stream
	p.volume_db = 0.0
	p.pitch_scale = 1.0
	p.play()


## Plays a one-shot music cue over the current music, ducking the music by duck_db meanwhile.
func sting(id: String, duck_db: float = -9.0, fade: float = 0.35) -> void:
	_setup()
	var stream := _load(DIR_MUSIC + id + ".wav", true)
	if stream == null:
		return
	_sting.stream = stream
	_sting.volume_db = 0.0
	_sting.play()
	_set_duck(db_to_linear(duck_db), fade)


## Starts (or keeps) a looping SFX under `key` (e.g. a fire barrel) and fades it in.
func sfx_loop(id: String, key: String = "", volume_db: float = 0.0, fade: float = 0.5) -> void:
	_setup()
	var k := key if key != "" else id
	if _loops.has(k):
		var f0: _Fader = _loops[k]
		f0.player.set_meta("base_db", volume_db)
		f0.start(1.0, fade, false)
		return
	var stream := _load(DIR_SFX + id + ".wav", true)
	if stream == null:
		return
	_ensure_loop(stream)
	var f := _Fader.new()
	f.player = _make_player("Loop_" + k.validate_node_name(), "SFX")
	f.player.stream = stream
	f.player.volume_db = MIN_DB
	f.player.set_meta("base_db", volume_db)
	f.player.play()
	f.start(1.0, fade, false)
	_loops[k] = f


func stop_sfx_loop(key: String, fade: float = 0.5) -> void:
	if _loops.has(key):
		var f: _Fader = _loops[key]
		f.start(0.0, fade, true)


func has_sound(id: String) -> bool:
	for dir in [DIR_SFX, DIR_MUSIC, DIR_AMB]:
		if ResourceLoader.exists(dir + id + ".wav"):
			return true
	return not _variant_names(id).is_empty()


## Warms the SFX cache (avoids a first-play hitch), e.g. preload_sound("step_snow").
func preload_sound(id: String) -> void:
	for n in _variant_names(id):
		_load(DIR_SFX + n + ".wav", false)


func set_bus_volume_linear(bus: String, value: float) -> void:
	var idx := AudioServer.get_bus_index(bus)
	if idx >= 0:
		AudioServer.set_bus_volume_db(idx, linear_to_db(maxf(0.0001, value)))


# ------------------------------------------------------------------------------------- internals
func _process(delta: float) -> void:
	if _duck != _duck_target:
		_duck = move_toward(_duck, _duck_target, _duck_rate * delta)
	for ch: _Channel in [_amb, _mus]:
		var ducked := ch == _mus
		if ch.active != null:
			_apply_fader(ch.active, delta, ducked)
		var keep: Array = []
		for f: _Fader in ch.fading:
			_apply_fader(f, delta, ducked)
			if f.player.playing:
				keep.append(f)
			else:
				f.player.queue_free()
		ch.fading = keep
	var dead: Array = []
	for k in _loops:
		var f: _Fader = _loops[k]
		_apply_fader(f, delta, false)
		if f.stop_at_end and not f.player.playing:
			dead.append(k)
	for k in dead:
		(_loops[k] as _Fader).player.queue_free()
		_loops.erase(k)


func _apply_fader(f: _Fader, delta: float, ducked: bool) -> void:
	var running := f.step(delta)
	var g := f.gain * (_duck if ducked else 1.0)
	var base: float = f.player.get_meta("base_db", 0.0)
	f.player.volume_db = maxf(MIN_DB, linear_to_db(g) + base) if g > 0.00001 else MIN_DB
	if not running and f.stop_at_end and f.gain <= 0.0001 and f.player.playing:
		f.player.stop()
		f.player.stream = null


func _play_channel(ch: _Channel, id: String, dir: String, fade: float, loop: bool) -> void:
	_setup()
	if id == ch.current and (id == "" or (ch.active != null and ch.active.player.playing)):
		return
	if id == "":
		_fade_out_active(ch, fade)
		ch.current = ""
		return
	var stream := _load(dir + id + ".wav", true)
	if stream == null:
		return   # graceful: keep whatever is playing
	if loop:
		_ensure_loop(stream)
	_fade_out_active(ch, fade)
	var f := _Fader.new()
	ch.serial += 1
	f.player = _make_player("%s%d" % [ch.prefix, ch.serial], ch.bus)
	if ch == _mus:
		f.player.finished.connect(_on_music_finished.bind(f))
	f.player.stream = stream
	f.player.volume_db = MIN_DB
	f.player.play()
	f.start(1.0, fade, false)
	ch.active = f
	ch.current = id


func _fade_out_active(ch: _Channel, fade: float) -> void:
	if ch.active != null:
		ch.active.start(0.0, fade, true)
		ch.fading.append(ch.active)
		ch.active = null


func _on_music_finished(f: _Fader) -> void:
	# a one-shot cue ended on its own: the channel is silent now
	f.gain = 0.0
	if _mus.active == f:
		_mus.active = null
		_mus.current = ""
		f.player.queue_free()


func _on_sting_finished() -> void:
	_set_duck(1.0, 0.8)


func _set_duck(target: float, seconds: float) -> void:
	_duck_target = clampf(target, 0.0, 1.0)
	_duck_rate = absf(_duck_target - _duck) / maxf(seconds, 0.01)


func _ensure_loop(stream: AudioStream) -> void:
	if stream is AudioStreamWAV:
		var w := stream as AudioStreamWAV
		if w.loop_mode == AudioStreamWAV.LOOP_DISABLED:
			w.loop_mode = AudioStreamWAV.LOOP_FORWARD
			w.loop_begin = 0
			w.loop_end = int(round(w.get_length() * w.mix_rate))


func _resolve_oneshot(id: String, warn: bool = true) -> AudioStream:
	var names := _variant_names(id)
	if names.is_empty():
		if warn:
			_warn_missing(DIR_SFX + id + ".wav")
		return null
	var pick: String = names[0]
	if names.size() > 1:
		var last: String = _last_variant.get(id, "")
		for _i in 4:
			pick = names[_rng.randi_range(0, names.size() - 1)]
			if pick != last:
				break
		_last_variant[id] = pick
	return _load(DIR_SFX + pick + ".wav", warn)


func _variant_names(id: String) -> PackedStringArray:
	if _variants.has(id):
		return _variants[id]
	var out := PackedStringArray()
	if ResourceLoader.exists(DIR_SFX + id + ".wav"):
		out.append(id)
	else:
		var i := 1
		while i <= 32 and ResourceLoader.exists(DIR_SFX + "%s_%d.wav" % [id, i]):
			out.append("%s_%d" % [id, i])
			i += 1
	_variants[id] = out
	return out


func _load(path: String, warn: bool = true) -> AudioStream:
	if _cache.has(path):
		return _cache[path]
	if not ResourceLoader.exists(path):
		if warn:
			_warn_missing(path)
		return null
	var s := load(path) as AudioStream
	if s == null:
		if warn:
			_warn_missing(path)
		return null
	if path.begins_with(DIR_SFX):
		_cache[path] = s
	return s


func _warn_missing(path: String) -> void:
	if not _warned.has(path):
		_warned[path] = true
		push_warning("Audio: missing sound '%s' (ignored)" % path)


func _next_voice(pool: Array[AudioStreamPlayer], is_sfx: bool) -> AudioStreamPlayer:
	for p in pool:
		if not p.playing:
			return p
	# all voices busy: steal round-robin (roughly the oldest)
	if is_sfx:
		_sfx_next = (_sfx_next + 1) % pool.size()
		return pool[_sfx_next]
	_ui_next = (_ui_next + 1) % pool.size()
	return pool[_ui_next]


func _make_player(node_name: String, bus: String) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.name = node_name
	p.bus = bus if AudioServer.get_bus_index(bus) >= 0 else "Master"
	add_child(p)
	return p


func _ensure_buses() -> void:
	## default_bus_layout.tres normally provides the buses; create any that are missing (tests, tools).
	for b in BUSES:
		if AudioServer.get_bus_index(b) < 0:
			AudioServer.add_bus()
			var idx := AudioServer.bus_count - 1
			AudioServer.set_bus_name(idx, b)
			AudioServer.set_bus_send(idx, "Master")


func _hook_settings() -> void:
	var s := get_node_or_null("/root/Settings")
	if s == null:
		return
	if s.has_method("get_value"):
		for key in VOLUME_KEYS:
			var v = s.get_value(key)
			if v != null:
				set_bus_volume_linear(VOLUME_KEYS[key], float(v))
	if s.has_signal("changed") and not s.changed.is_connected(_on_setting_changed):
		s.changed.connect(_on_setting_changed)


func _on_setting_changed(key: String, value) -> void:
	if VOLUME_KEYS.has(key):
		set_bus_volume_linear(VOLUME_KEYS[key], float(value))
