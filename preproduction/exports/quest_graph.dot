digraph AshesQuest {
  rankdir=LR;
  node [shape=box,fontname="Arial"];
  subgraph cluster_q_a1_last_signal {
    label="q_a1_last_signal";
    "a1_talk_irina";
    "a1_inspect_seal";
    "a1_talk_irina" -> "a1_inspect_seal";
    "a1_inspect_timetable";
    "a1_talk_irina" -> "a1_inspect_timetable";
    "a1_solve_signal";
    "a1_inspect_seal" -> "a1_solve_signal";
    "a1_inspect_timetable" -> "a1_solve_signal";
    "a1_inspect_ledger";
    "a1_solve_signal" -> "a1_inspect_ledger";
    "a1_choose";
    "a1_inspect_ledger" -> "a1_choose";
  }
  subgraph cluster_q_m1_wrong_blueprint {
    label="q_m1_wrong_blueprint";
    "m1_inspect_plan_a";
    "m1_inspect_plan_b";
    "m1_align_plans";
    "m1_inspect_plan_a" -> "m1_align_plans";
    "m1_inspect_plan_b" -> "m1_align_plans";
    "m1_talk_emil";
    "m1_align_plans" -> "m1_talk_emil";
    "m1_choose";
    "m1_talk_emil" -> "m1_choose";
  }
  "a1_choose" -> "m1_inspect_plan_a" [style=dashed,label="a1_completed"];
  "a1_choose" -> "m1_inspect_plan_b" [style=dashed];
}
